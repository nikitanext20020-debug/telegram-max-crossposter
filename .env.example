# Никогда не вставляйте сюда уже засвеченные токены. Сначала перевыпустите их.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=

# Получите через: npm run discover:max
MAX_CHAT_ID=

# Можно оставить пустым: тогда бот принимает посты из любого канала,
# где он администратор. Для нескольких каналов укажите ID через запятую.
TELEGRAM_SOURCE_CHAT_IDS=

# Случайная строка из букв, цифр, _ и -, длина 32+ символа.
TELEGRAM_WEBHOOK_SECRET=

# Адрес после размещения, без завершающего /.
PUBLIC_URL=https://your-service.koyeb.app

# Подпись добавляется к каждому сообщению в MAX.
MAX_SIGNATURE_TEXT=ЛУЧШИЙ ВПН (БЕСПЛАТНО)
MAX_SIGNATURE_URL=https://nosokvpn.com/?ref=p1_UAkMu8To0LPBeXr55PI

MAX_NOTIFY=true
MAX_DISABLE_LINK_PREVIEW=false
PORT=8000
