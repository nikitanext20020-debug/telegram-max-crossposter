{
  "name": "telegram-to-max-crossposter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "discover:max": "node --env-file-if-exists=.env scripts/discover-max-chat.mjs",
    "register:webhook": "node --env-file-if-exists=.env scripts/register-telegram-webhook.mjs",
    "check:webhook": "node --env-file-if-exists=.env scripts/check-telegram-webhook.mjs",
    "test": "node --test"
  }
}
